# Copy to .env and fill in your real values. Never commit .env.
#
# From the Alpaca dashboard: Paper Trading -> API Keys.
# Generate once, copy the Secret Key immediately (shown only that one time).

ALPACA_API_KEY_ID=your-key-id
ALPACA_API_SECRET_KEY=your-secret-key

# Paper trading (simulated orders) vs live — start on paper, always.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# console.anthropic.com -> API Keys. Used by pipeline/read_stage.py to call
# Claude programmatically (the actual Read-stage automation) — separate
# from any Claude Code session credential. Real cost per call, see that
# file's docstring (~$0.10-0.30 per paper with claude-opus-5).
ANTHROPIC_API_KEY=your-anthropic-api-key
