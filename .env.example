# Copy to .env and fill in your real values. Never commit .env.
#
# From the Alpaca dashboard: Paper Trading -> API Keys.
# Generate once, copy the Secret Key immediately (shown only that one time).

ALPACA_API_KEY_ID=your-key-id
ALPACA_API_SECRET_KEY=your-secret-key

# Paper trading (simulated orders) vs live — start on paper, always.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
